POSTGRES_DB=flowcart
POSTGRES_USER=flowcart
POSTGRES_PASSWORD=flowcart_dev
DATABASE_URL=postgres://flowcart:flowcart_dev@localhost:5433/flowcart?sslmode=disable
# Development placeholder only. Production requires >=32 random bytes; generate 64.
JWT_SECRET=replace-with-a-long-development-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
APP_ENV=development
# development/test/verification/production only; blank defaults to development.
# Production requires explicit HTTPS origins (comma-separated, no wildcards).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
PAYMENTS_PROVIDER=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_EXPECTED_LIVEMODE=false
FLOWCART_SEED_CONFIRM=FLOWCART_DEMO
